{
  "manifest_version": 3,
  "name": "DHTN Văn Bản Monitor to Telegram",
  "version": "1.2.0",
  "description": "Theo dõi số lượng Văn bản đến / Văn bản đi trên hệ thống DHTN (dhtn.dcs.vn) và báo Telegram",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.telegram.org/*",
    "https://dhtn.dcs.vn/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dhtn.dcs.vn/*",
        "*://dhtn.dcs.vn/*",
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
